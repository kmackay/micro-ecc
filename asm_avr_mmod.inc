/* Constant-time fast reductions (vli_mmod_fast) for AVR.
   Generated by scripts/mmod_avr.py. Each routine reduces a 2 * num_words
   product to the fully reduced result in [0, p); result may alias product.
   The top carry is folded back first, leaving result + c2 * 2^N with c2 in
   {-1, 0, 1} and a value in (-p, 2p); then a read-only pass compares result
   with p and a final pass adds p, subtracts p (adds 2^N - p) or adds 0,
   selected with masks. */

#ifndef _UECC_ASM_AVR_MMOD_H_
#define _UECC_ASM_AVR_MMOD_H_

