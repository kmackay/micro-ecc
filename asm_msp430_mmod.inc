/* Constant-time fast reductions (vli_mmod_fast) for the classic MSP430.
   Generated by scripts/mmod_msp430.py. Each routine reduces a 2 * num_words
   product to the fully reduced result in [0, p); result may alias product.
   The high half is folded into the low half with 16-bit column sums, then the
   top carry is folded back, leaving result + c2 * 2^N with c2 in {-1, 0, 1}
   and a value in (-p, 2p); a read-only pass compares it with p and a final
   pass adds p, subtracts p (adds 2^N - p) or adds 0, selected with masks. */

#ifndef _UECC_ASM_MSP430_MMOD_H_
#define _UECC_ASM_MSP430_MMOD_H_

#if uECC_SUPPORTS_secp160r1
/* Computes result = product % p (secp160r1), constant time.
   Column sums of lo + hi + hi * 2^31 (2^160 = 2^31 + 1 (mod p)); the carry
   is folded back the same way, then p is subtracted once if needed. */
__attribute__((noinline))
static void vli_mmod_fast_secp160r1(uint16_t *result, uint16_t *product) {
    register uint16_t *r12 __asm__("r12") = result;
    register uint16_t *r13 __asm__("r13") = product;
    __asm__ volatile (
        /* Save the callee-saved registers used below. */
        "push r8 \n\t"
        "push r9 \n\t"
        "push r10 \n\t"
        /* Column 0: l[0] + h[0]. */
        "mov @r13+, r14 \n\t"
        "mov #0, r15 \n\t"
        "mov 18(r13), r11 \n\t"
        "add r11, r14 \n\t"
        "adc r15 \n\t"
        "mov r14, 0(r12) \n\t"
        /* Column 1: l[1] + h[1] + ((h[0] << 15) | (h[-1] >> 1)) + carry. */
        "mov #0, r14 \n\t"
        "add @r13+, r15 \n\t"
        "adc r14 \n\t"
        "mov 18(r13), r10 \n\t"
        "add r10, r15 \n\t"
        "adc r14 \n\t"
        "mov #0, r9 \n\t"
        "bit #1, r11 \n\t"
        "rrc r9 \n\t"
        "add r9, r15 \n\t"
        "adc r14 \n\t"
        "mov r15, 2(r12) \n\t"
        /* Column 2: l[2] + h[2] + ((h[1] << 15) | (h[0] >> 1)) + carry. */
        "mov #0, r15 \n\t"
        "add @r13+, r14 \n\t"
        "adc r15 \n\t"
        "mov 18(r13), r9 \n\t"
        "add r9, r14 \n\t"
        "adc r15 \n\t"
        "bit #1, r10 \n\t"
        "rrc r11 \n\t"
        "add r11, r14 \n\t"
        "adc r15 \n\t"
        "mov r14, 4(r12) \n\t"
        /* Column 3: l[3] + h[3] + ((h[2] << 15) | (h[1] >> 1)) + carry. */
        "mov #0, r14 \n\t"
        "add @r13+, r15 \n\t"
        "adc r14 \n\t"
        "mov 18(r13), r11 \n\t"
        "add r11, r15 \n\t"
        "adc r14 \n\t"
        "bit #1, r9 \n\t"
        "rrc r10 \n\t"
        "add r10, r15 \n\t"
        "adc r14 \n\t"
        "mov r15, 6(r12) \n\t"
        /* Column 4: l[4] + h[4] + ((h[3] << 15) | (h[2] >> 1)) + carry. */
        "mov #0, r15 \n\t"
        "add @r13+, r14 \n\t"
        "adc r15 \n\t"
        "mov 18(r13), r10 \n\t"
        "add r10, r14 \n\t"
        "adc r15 \n\t"
        "bit #1, r11 \n\t"
        "rrc r9 \n\t"
        "add r9, r14 \n\t"
        "adc r15 \n\t"
        "mov r14, 8(r12) \n\t"
        /* Column 5: l[5] + h[5] + ((h[4] << 15) | (h[3] >> 1)) + carry. */
        "mov #0, r14 \n\t"
        "add @r13+, r15 \n\t"
        "adc r14 \n\t"
        "mov 18(r13), r9 \n\t"
        "add r9, r15 \n\t"
        "adc r14 \n\t"
        "bit #1, r10 \n\t"
        "rrc r11 \n\t"
        "add r11, r15 \n\t"
        "adc r14 \n\t"
        "mov r15, 10(r12) \n\t"
        /* Column 6: l[6] + h[6] + ((h[5] << 15) | (h[4] >> 1)) + carry. */
        "mov #0, r15 \n\t"
        "add @r13+, r14 \n\t"
        "adc r15 \n\t"
        "mov 18(r13), r11 \n\t"
        "add r11, r14 \n\t"
        "adc r15 \n\t"
        "bit #1, r9 \n\t"
        "rrc r10 \n\t"
        "add r10, r14 \n\t"
        "adc r15 \n\t"
        "mov r14, 12(r12) \n\t"
        /* Column 7: l[7] + h[7] + ((h[6] << 15) | (h[5] >> 1)) + carry. */
        "mov #0, r14 \n\t"
        "add @r13+, r15 \n\t"
        "adc r14 \n\t"
        "mov 18(r13), r10 \n\t"
        "add r10, r15 \n\t"
        "adc r14 \n\t"
        "bit #1, r11 \n\t"
        "rrc r9 \n\t"
        "add r9, r15 \n\t"
        "adc r14 \n\t"
        "mov r15, 14(r12) \n\t"
        /* Column 8: l[8] + h[8] + ((h[7] << 15) | (h[6] >> 1)) + carry. */
        "mov #0, r15 \n\t"
        "add @r13+, r14 \n\t"
        "adc r15 \n\t"
        "mov 18(r13), r9 \n\t"
        "add r9, r14 \n\t"
        "adc r15 \n\t"
        "bit #1, r10 \n\t"
        "rrc r11 \n\t"
        "add r11, r14 \n\t"
        "adc r15 \n\t"
        "mov r14, 16(r12) \n\t"
        /* Column 9: l[9] + h[9] + ((h[8] << 15) | (h[7] >> 1)) + carry. */
        "mov #0, r14 \n\t"
        "add @r13+, r15 \n\t"
        "adc r14 \n\t"
        "mov 18(r13), r11 \n\t"
        "add r11, r15 \n\t"
        "adc r14 \n\t"
        "bit #1, r9 \n\t"
        "rrc r10 \n\t"
        "add r10, r15 \n\t"
        "adc r14 \n\t"
        /* c = carry + (h >> 1) * 2^16 + (h[9] << 15 | h[8] >> 1), the part above 2^160. */
        "bit #1, r11 \n\t"
        "rrc r9 \n\t"
        "clrc \n\t"
        "rrc r11 \n\t"
        "add r9, r14 \n\t"
        "adc r11 \n\t"
        /* X = c + c * 2^31 = c * d. */
        "mov r11, r10 \n\t"
        "mov r14, r9 \n\t"
        "mov #0, r13 \n\t"
        "clrc \n\t"
        "rrc r10 \n\t"
        "rrc r9 \n\t"
        "rrc r13 \n\t"
        "add r13, r11 \n\t"
        "adc r9 \n\t"
        "adc r10 \n\t"
        /* e = top word of result + (c + (c >= 0)) * d (read-only pass): 1 if the
           value is >= p, -1 if it is < 0, else 0. */
        "add #1, r14 \n\t"
        "addc #-32768, r11 \n\t"
        "addc #0, r9 \n\t"
        "addc #0, r10 \n\t"
        /* u = AND of result words 4..9. */
        "mov 8(r12), r8 \n\t"
        "and 10(r12), r8 \n\t"
        "and 12(r12), r8 \n\t"
        "and 14(r12), r8 \n\t"
        "and 16(r12), r8 \n\t"
        "and r15, r8 \n\t"
        "mov @r12, r13 \n\t"
        "add r14, r13 \n\t"
        "mov 2(r12), r13 \n\t"
        "addc r11, r13 \n\t"
        "mov 4(r12), r13 \n\t"
        "addc r9, r13 \n\t"
        "mov 6(r12), r13 \n\t"
        "addc r10, r13 \n\t"
        "adc r8 \n\t"
        "mov #0, r13 \n\t"
        "adc r13 \n\t"
        /* X -= d & (e - 1); result += X (mod 2^N). */
        "dec r13 \n\t"
        "mov r13, r8 \n\t"
        "and #1, r8 \n\t"
        "and #-32768, r13 \n\t"
        "sub r8, r14 \n\t"
        "subc r13, r11 \n\t"
        "sbc r9 \n\t"
        "sbc r10 \n\t"
        "add r14, 0(r12) \n\t"
        "addc r11, 2(r12) \n\t"
        "addc r9, 4(r12) \n\t"
        "addc r10, 6(r12) \n\t"
        "adc 8(r12) \n\t"
        "adc 10(r12) \n\t"
        "adc 12(r12) \n\t"
        "adc 14(r12) \n\t"
        "adc 16(r12) \n\t"
        "adc r15 \n\t"
        "mov r15, 18(r12) \n\t"
        "pop r10 \n\t"
        "pop r9 \n\t"
        "pop r8 \n\t"
        : "+r" (r13)
        : "r" (r12)
        : "r11", "r14", "r15", "cc", "memory"
    );
}
#define asm_mmod_fast_secp160r1 1
#endif /* uECC_SUPPORTS_secp160r1 */

#if uECC_SUPPORTS_secp192r1
/* Computes result = product % p (secp192r1), constant time.
   Column sums of t + s1 + s2 + s3, then the carry c is folded back using
   2^192 = 2^64 + 1 (mod p), and p is subtracted once if needed. */
__attribute__((noinline))
static void vli_mmod_fast_secp192r1(uint16_t *result, uint16_t *product) {
    register uint16_t *r12 __asm__("r12") = result;
    register uint16_t *r13 __asm__("r13") = product;
    __asm__ volatile (
        /* Save the callee-saved registers used below. */
        "push r4 \n\t"
        "push r5 \n\t"
        "push r6 \n\t"
        "push r7 \n\t"
        "push r10 \n\t"
        /* Column 0: l[0] + a[0] + a[4] (32-bit words). */
        "mov @r13+, r14 \n\t"
        "mov @r13+, r15 \n\t"
        "mov #0, r11 \n\t"
        "add 20(r13), r14 \n\t"
        "addc 22(r13), r15 \n\t"
        "adc r11 \n\t"
        "mov 36(r13), r4 \n\t"
        "mov 38(r13), r5 \n\t"
        "add r4, r14 \n\t"
        "addc r5, r15 \n\t"
        "adc r11 \n\t"
        "mov r14, 0(r12) \n\t"
        "mov r15, 2(r12) \n\t"
        /* Column 1: l[1] + a[1] + a[5] + carry (32-bit words). */
        "mov #0, r14 \n\t"
        "mov #0, r15 \n\t"
        "add @r13+, r11 \n\t"
        "addc @r13+, r14 \n\t"
        "adc r15 \n\t"
        "add 20(r13), r11 \n\t"
        "addc 22(r13), r14 \n\t"
        "adc r15 \n\t"
        "mov 36(r13), r6 \n\t"
        "mov 38(r13), r7 \n\t"
        "add r6, r11 \n\t"
        "addc r7, r14 \n\t"
        "adc r15 \n\t"
        "mov r11, 4(r12) \n\t"
        "mov r14, 6(r12) \n\t"
        /* Column 2: l[2] + a[2] + a[0] + a[4] + carry (32-bit words). */
        "mov #0, r11 \n\t"
        "mov #0, r14 \n\t"
        "add @r13+, r15 \n\t"
        "addc @r13+, r11 \n\t"
        "adc r14 \n\t"
        "add 20(r13), r15 \n\t"
        "addc 22(r13), r11 \n\t"
        "adc r14 \n\t"
        "add 12(r13), r15 \n\t"
        "addc 14(r13), r11 \n\t"
        "adc r14 \n\t"
        "add r4, r15 \n\t"
        "addc r5, r11 \n\t"
        "adc r14 \n\t"
        "mov r15, 8(r12) \n\t"
        "mov r11, 10(r12) \n\t"
        /* Column 3: l[3] + a[3] + a[1] + a[5] + carry (32-bit words). */
        "mov #0, r15 \n\t"
        "mov #0, r11 \n\t"
        "add @r13+, r14 \n\t"
        "addc @r13+, r15 \n\t"
        "adc r11 \n\t"
        "add 20(r13), r14 \n\t"
        "addc 22(r13), r15 \n\t"
        "adc r11 \n\t"
        "add 12(r13), r14 \n\t"
        "addc 14(r13), r15 \n\t"
        "adc r11 \n\t"
        "add r6, r14 \n\t"
        "addc r7, r15 \n\t"
        "adc r11 \n\t"
        "mov r14, 12(r12) \n\t"
        "mov r15, 14(r12) \n\t"
        /* Column 4: l[4] + a[4] + a[2] + carry (32-bit words). */
        "mov #0, r14 \n\t"
        "mov #0, r15 \n\t"
        "add @r13+, r11 \n\t"
        "addc @r13+, r14 \n\t"
        "adc r15 \n\t"
        "add r4, r11 \n\t"
        "addc r5, r14 \n\t"
        "adc r15 \n\t"
        "add 12(r13), r11 \n\t"
        "addc 14(r13), r14 \n\t"
        "adc r15 \n\t"
        "mov r11, 16(r12) \n\t"
        "mov r14, 18(r12) \n\t"
        /* Column 5: l[5] + a[5] + a[3] + carry (32-bit words). */
        "mov #0, r11 \n\t"
        "mov #0, r14 \n\t"
        "add @r13+, r15 \n\t"
        "addc @r13+, r11 \n\t"
        "adc r14 \n\t"
        "add r6, r15 \n\t"
        "addc r7, r11 \n\t"
        "adc r14 \n\t"
        "add 12(r13), r15 \n\t"
        "addc 14(r13), r11 \n\t"
        "adc r14 \n\t"
        /* e = top word of result + (c + (c >= 0)) * d (read-only pass): 1 if the
           value is >= p, -1 if it is < 0, else 0. */
        "mov r14, r13 \n\t"
        "inc r13 \n\t"
        /* u = AND of result words 5..11. */
        "mov 10(r12), r10 \n\t"
        "and 12(r12), r10 \n\t"
        "and 14(r12), r10 \n\t"
        "and 16(r12), r10 \n\t"
        "and 18(r12), r10 \n\t"
        "and r15, r10 \n\t"
        "and r11, r10 \n\t"
        "mov @r12, r4 \n\t"
        "add r13, r4 \n\t"
        "mov 2(r12), r4 \n\t"
        "adc r4 \n\t"
        "mov 4(r12), r4 \n\t"
        "adc r4 \n\t"
        "mov 6(r12), r4 \n\t"
        "adc r4 \n\t"
        "mov 8(r12), r4 \n\t"
        "addc r13, r4 \n\t"
        "adc r10 \n\t"
        "mov #0, r4 \n\t"
        "adc r4 \n\t"
        /* result += (c + e) * d (mod 2^N). */
        "add r4, r14 \n\t"
        "add r14, 0(r12) \n\t"
        "adc 2(r12) \n\t"
        "adc 4(r12) \n\t"
        "adc 6(r12) \n\t"
        "addc r14, 8(r12) \n\t"
        "adc 10(r12) \n\t"
        "adc 12(r12) \n\t"
        "adc 14(r12) \n\t"
        "adc 16(r12) \n\t"
        "adc 18(r12) \n\t"
        "adc r15 \n\t"
        "adc r11 \n\t"
        "mov r15, 20(r12) \n\t"
        "mov r11, 22(r12) \n\t"
        "pop r10 \n\t"
        "pop r7 \n\t"
        "pop r6 \n\t"
        "pop r5 \n\t"
        "pop r4 \n\t"
        : "+r" (r13)
        : "r" (r12)
        : "r11", "r14", "r15", "cc", "memory"
    );
}
#define asm_mmod_fast_secp192r1 1
#endif /* uECC_SUPPORTS_secp192r1 */

