#if (uECC_SUPPORTS_secp256r1 || uECC_SUPPORTS_secp256k1)
#if (uECC_MIN_WORDS < 8)
    if (num_words == 8)
#endif
    {
        __asm__ volatile (
            ".syntax unified \n\t"
            /* result = left - right, in r4..r11. Low 4 words first. */
            "ldmia r1!, {r4, r5, r6, r7} \n\t"
            "ldmia r2!, {r8, r9, r10, r11} \n\t"
