            "and r2, r2, r1 \n\t"
            "and r10, r10, r1 \n\t"
            "and r11, r11, r1 \n\t"
            "and lr, lr, r1 \n\t"
            "adds r4, r4, r2 \n\t"
            "adcs r5, r5, r10 \n\t"
            "adcs r6, r6, r11 \n\t"
            "adcs r7, r7, lr \n\t"
            "ldmia r3!, {r2, lr} \n\t"
            "and r2, r2, r1 \n\t"
            "and lr, lr, r1 \n\t"
            "adcs r8, r8, r2 \n\t"
            "adcs r9, r9, lr \n\t"
