            "sbcs r6, r6, r11 \n\t"
            "sbcs r7, r7, lr \n\t"
            "ldmia r3!, {r1, r2, lr} \n\t"
            "sbcs r8, r8, r1 \n\t"
            "sbcs r9, r9, r2 \n\t"
            "sbcs r10, r10, lr \n\t"
            "sbc r1, r1, r1 \n\t"  /* b = -borrow. */
            "and r1, r1, r12 \n\t"  /* Add mod back iff borrow and no carry. */
            "sub r3, r3, #28 \n\t"  /* Rewind r3 to mod. */
            /* result += mod & b (ldm / and leave the carry intact). */
            "ldmia r3!, {r2, r11, lr} \n\t"
            "and r2, r2, r1 \n\t"
            "and r11, r11, r1 \n\t"
            "and lr, lr, r1 \n\t"
            "adds r4, r4, r2 \n\t"
            "adcs r5, r5, r11 \n\t"
            "adcs r6, r6, lr \n\t"
            "ldmia r3!, {r2, r11, lr} \n\t"
            "and r2, r2, r1 \n\t"
            "and r11, r11, r1 \n\t"
            "and lr, lr, r1 \n\t"
            "adcs r7, r7, r2 \n\t"
            "adcs r8, r8, r11 \n\t"
            "adcs r9, r9, lr \n\t"
            "ldr r2, [r3], #4 \n\t"
            "and r2, r2, r1 \n\t"
            "adcs r10, r10, r2 \n\t"
            "stmia r0, {r4, r5, r6, r7, r8, r9, r10} \n\t"
            RESUME_SYNTAX
            : "+r" (r0), "+r" (r1), "+r" (r2), "+r" (r3)
            :
            : "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "r14", "cc", "memory"
        );
        return;
    }
#endif
#if (uECC_SUPPORTS_secp160r1 || uECC_SUPPORTS_secp192r1)
#if (uECC_MIN_WORDS < 6)
