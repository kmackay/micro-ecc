            "adds r4, r4, r8 \n\t"
            "adcs r5, r5, r9 \n\t"
            "adcs r6, r6, r10 \n\t"
            "adcs r7, r7, r11 \n\t"
            /* Upper words. Temps reuse registers that are no longer needed. */
            "ldmia r1, {r8, r9} \n\t"
            "ldmia r2, {r10, r11} \n\t"
            "adcs r8, r8, r10 \n\t"
            "adcs r9, r9, r11 \n\t"
            "sbc r12, r12, r12 \n\t"  /* c = carry - 1 (0 if the add carried). */
            /* result -= mod. */
