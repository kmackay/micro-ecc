   right, then (mod & -borrow) is added back.
   Assumes that left < mod and right < mod, and that result does not overlap
   mod. */
uECC_VLI_API void uECC_vli_modSub(uECC_word_t *result,
                                  const uECC_word_t *left,
                                  const uECC_word_t *right,
                                  const uECC_word_t *mod,
                                  wordcount_t num_words) {
    register uECC_word_t *r0 __asm__("r0") = result;
    register const uECC_word_t *r1 __asm__("r1") = left;
    register const uECC_word_t *r2 __asm__("r2") = right;
