            "subs r4, r4, r1 \n\t"
            "sbcs r5, r5, r2 \n\t"
            "sbcs r6, r6, r10 \n\t"
            "sbcs r7, r7, r11 \n\t"
            "sbcs r8, r8, lr \n\t"
            "ldr r1, [r3], #4 \n\t"
            "sbcs r9, r9, r1 \n\t"
            "sbc r1, r1, r1 \n\t"  /* b = -borrow. */
            "and r1, r1, r12 \n\t"  /* Add mod back iff borrow and no carry. */
