/* Fused constant-time modular addition / subtraction for Thumb-2 and ARM.
   Generated by scripts/modaddsub_arm.py. The smallest supported size
   (uECC_MIN_WORDS) is handled unconditionally as the last case. */

#ifndef _UECC_ASM_ARM_MODADDSUB_H_
#define _UECC_ASM_ARM_MODADDSUB_H_

/* Computes result = (left + right) % mod in constant time: result = left +
   right, then result -= mod, then mod is added back if the sum was < mod (the
   subtraction borrowed and the addition did not carry).
   Assumes that left < mod and right < mod, and that result does not overlap
   mod. */
uECC_VLI_API void uECC_vli_modAdd(uECC_word_t *result,
                                  const uECC_word_t *left,
                                  const uECC_word_t *right,
                                  const uECC_word_t *mod,
                                  wordcount_t num_words) {
    register uECC_word_t *r0 __asm__("r0") = result;
    register const uECC_word_t *r1 __asm__("r1") = left;
    register const uECC_word_t *r2 __asm__("r2") = right;
    register const uECC_word_t *r3 __asm__("r3") = mod;
#if (uECC_SUPPORTS_secp256r1 || uECC_SUPPORTS_secp256k1)
#if (uECC_MIN_WORDS < 8)
    if (num_words == 8)
#endif
    {
        __asm__ volatile (
            ".syntax unified \n\t"
            /* result = left + right, in r4..r11. Low 4 words first. */
            "ldmia r1!, {r4, r5, r6, r7} \n\t"
            "ldmia r2!, {r8, r9, r10, r11} \n\t"
            "adds r4, r4, r8 \n\t"
            "adcs r5, r5, r9 \n\t"
            "adcs r6, r6, r10 \n\t"
            "adcs r7, r7, r11 \n\t"
            /* Upper words. Temps reuse registers that are no longer needed. */
            "ldmia r1, {r8, r9, r10, r11} \n\t"
            "ldmia r2, {r1, r2, r12, lr} \n\t"
            "adcs r8, r8, r1 \n\t"
            "adcs r9, r9, r2 \n\t"
            "adcs r10, r10, r12 \n\t"
            "adcs r11, r11, lr \n\t"
            "sbc r12, r12, r12 \n\t"  /* c = carry - 1 (0 if the add carried). */
            /* result -= mod. */
            "ldmia r3!, {r1, r2, lr} \n\t"
            "subs r4, r4, r1 \n\t"
            "sbcs r5, r5, r2 \n\t"
            "sbcs r6, r6, lr \n\t"
            "ldmia r3!, {r1, r2, lr} \n\t"
            "sbcs r7, r7, r1 \n\t"
            "sbcs r8, r8, r2 \n\t"
            "sbcs r9, r9, lr \n\t"
            "ldmia r3!, {r1, r2} \n\t"
            "sbcs r10, r10, r1 \n\t"
            "sbcs r11, r11, r2 \n\t"
            "sbc r1, r1, r1 \n\t"  /* b = -borrow. */
            "and r1, r1, r12 \n\t"  /* Add mod back iff borrow and no carry. */
            "sub r3, r3, #32 \n\t"  /* Rewind r3 to mod. */
            /* result += mod & b (ldm / and leave the carry intact). */
            "ldmia r3!, {r2, lr} \n\t"
            "and r2, r2, r1 \n\t"
            "and lr, lr, r1 \n\t"
            "adds r4, r4, r2 \n\t"
            "adcs r5, r5, lr \n\t"
            "ldmia r3!, {r2, lr} \n\t"
            "and r2, r2, r1 \n\t"
            "and lr, lr, r1 \n\t"
            "adcs r6, r6, r2 \n\t"
            "adcs r7, r7, lr \n\t"
            "ldmia r3!, {r2, lr} \n\t"
            "and r2, r2, r1 \n\t"
            "and lr, lr, r1 \n\t"
            "adcs r8, r8, r2 \n\t"
            "adcs r9, r9, lr \n\t"
            "ldmia r3!, {r2, lr} \n\t"
            "and r2, r2, r1 \n\t"
            "and lr, lr, r1 \n\t"
            "adcs r10, r10, r2 \n\t"
            "adcs r11, r11, lr \n\t"
            "stmia r0, {r4, r5, r6, r7, r8, r9, r10, r11} \n\t"
            RESUME_SYNTAX
            : "+r" (r0), "+r" (r1), "+r" (r2), "+r" (r3)
            :
            : "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "r14", "cc", "memory"
        );
        return;
    }
#endif
