        "ldr r6, [r1, #36] \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r4, r5 \n\t"
        "ldr r6, [r1, #28] \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r4, r5 \n\t"
        "ldr r6, [r1, #44] \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r4, r5 \n\t"
        "str r2, [r0, #12] \n\t"
        /* column 4 */
