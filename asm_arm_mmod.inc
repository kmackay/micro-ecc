/* Computes result = product % p (secp160r1), constant time.
   lo + hi + hi * 2^31 using 2^160 = 2^31 + 1 (mod p), then the carry is
   folded back the same way. For small c, folding c adds the two's complement
   words of c * (2^31 + 1): [c + (c << 31), s, s, s, s] (s = c >> 31). */
static void vli_mmod_fast_secp160r1(uint32_t *result, uint32_t *product) {
    register uint32_t *r0 __asm__("r0") = result;
    register uint32_t *r1 __asm__("r1") = product;
    __asm__ volatile (
        ".syntax unified \n\t"
        "ldm r1!, {r2-r6} \n\t"
        "ldm r1, {r7-r11} \n\t"
        "mov r12, #0 \n\t"
        /* + hi */
        "adds r2, r2, r7 \n\t"
        "adcs r3, r3, r8 \n\t"
        "adcs r4, r4, r9 \n\t"
        "adcs r5, r5, r10 \n\t"
        "adcs r6, r6, r11 \n\t"
        "adc r12, r12, #0 \n\t"
        /* + hi * 2^31 */
        "lsl r14, r7, #31 \n\t"
        "adds r2, r2, r14 \n\t"
        "lsr r14, r7, #1 \n\t"
        "orr r14, r14, r8, lsl #31 \n\t"
        "adcs r3, r3, r14 \n\t"
        "lsr r14, r8, #1 \n\t"
        "orr r14, r14, r9, lsl #31 \n\t"
        "adcs r4, r4, r14 \n\t"
        "lsr r14, r9, #1 \n\t"
        "orr r14, r14, r10, lsl #31 \n\t"
        "adcs r5, r5, r14 \n\t"
        "lsr r14, r10, #1 \n\t"
        "orr r14, r14, r11, lsl #31 \n\t"
        "adcs r6, r6, r14 \n\t"
        "lsr r14, r11, #1 \n\t"
        "adc r12, r12, r14 \n\t"
        /* fold carry (c < 2^31 + 3): r += c * (2^31 + 1) */
        "lsl r7, r12, #31 \n\t"
        "adds r7, r7, r12 \n\t"
        "lsr r8, r12, #1 \n\t"
        "adc r8, r8, #0 \n\t"
        "mov r12, #0 \n\t"
        "adds r2, r2, r7 \n\t"
        "adcs r3, r3, r8 \n\t"
        "adcs r4, r4, #0 \n\t"
        "adcs r5, r5, #0 \n\t"
        "adcs r6, r6, #0 \n\t"
        "adc r12, r12, #0 \n\t"
        /* fold s = c2 | 1 (subtract p, or add p if c2 == -1) */
        "orr r9, r12, #1 \n\t"
        "asr r7, r9, #31 \n\t"
        "add r8, r9, r9, lsl #31 \n\t"
        "adds r2, r2, r8 \n\t"
        "adcs r3, r3, r7 \n\t"
        "adcs r4, r4, r7 \n\t"
        "adcs r5, r5, r7 \n\t"
        "adcs r6, r6, r7 \n\t"
        "adc r9, r7, #0 \n\t"
        /* undo (add p) if c2 == 0 and the previous fold did not carry */
        "orr r8, r12, r9 \n\t"
        "rsb r10, r8, #0 \n\t"
        "orr r8, r8, r10 \n\t"
        "mvn r12, r8, asr #31 \n\t"
        "asr r7, r12, #31 \n\t"
        "add r8, r12, r12, lsl #31 \n\t"
        "adds r2, r2, r8 \n\t"
        "adcs r3, r3, r7 \n\t"
        "adcs r4, r4, r7 \n\t"
        "adcs r5, r5, r7 \n\t"
        "adcs r6, r6, r7 \n\t"
        "adc r12, r7, #0 \n\t"
        "stm r0, {r2-r6} \n\t"
        RESUME_SYNTAX
        : "+r" (r0), "+r" (r1)
        :
        : "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "r14", "cc", "memory"
    );
