/* Constant-time fast reductions (vli_mmod_fast) for ARM, Thumb-2 and Thumb-1.
   Generated by scripts/mmod_arm.py. Each routine reduces a
   2 * num_words product to the fully reduced result in [0, p). result may
   alias product. The final steps are branch-free: after folding the top
   carry, c2 in {-1, 0, 1} remains; folding +1 is the same as subtracting p
   (and -1 as adding p) modulo 2^N, so we fold (c2 | 1) and then fold -1 again
   if c2 was 0 and that fold did not carry (the value was already < p). */

#ifndef _UECC_ASM_ARM_MMOD_H_
#define _UECC_ASM_ARM_MMOD_H_

#if (uECC_PLATFORM == uECC_arm_thumb)

#if uECC_SUPPORTS_secp160r1
/* Computes result = product % p (secp160r1), constant time (Thumb-1).
   lo + hi + hi * 2^31, then folds as in the Thumb-2 version. */
static void vli_mmod_fast_secp160r1(uint32_t *result, uint32_t *product) {
    register uint32_t *r0 __asm__("r0") = result;
    register uint32_t *r1 __asm__("r1") = product;
    __asm__ volatile (
        ".syntax unified \n\t"
        "movs r5, #0 \n\t"
        /* column 0: p[j] + a[j] + ((a[j] << 31) | (a[j-1] >> 1)) */
        "ldr r2, [r1, #0] \n\t"
        "movs r3, #0 \n\t"
        "ldr r6, [r1, #20] \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r3, r5 \n\t"
        "lsls r6, r6, #31 \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r3, r5 \n\t"
        "str r2, [r0, #0] \n\t"
        /* column 1: p[j] + a[j] + ((a[j] << 31) | (a[j-1] >> 1)) */
        "ldr r2, [r1, #4] \n\t"
        "movs r4, #0 \n\t"
        "adds r2, r2, r3 \n\t"
        "adcs r4, r5 \n\t"
        "ldr r6, [r1, #24] \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r4, r5 \n\t"
        "lsls r6, r6, #31 \n\t"
        "ldr r7, [r1, #20] \n\t"
        "lsrs r7, r7, #1 \n\t"
        "orrs r6, r7 \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r4, r5 \n\t"
        "str r2, [r0, #4] \n\t"
        /* column 2: p[j] + a[j] + ((a[j] << 31) | (a[j-1] >> 1)) */
        "ldr r2, [r1, #8] \n\t"
        "movs r3, #0 \n\t"
        "adds r2, r2, r4 \n\t"
        "adcs r3, r5 \n\t"
        "ldr r6, [r1, #28] \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r3, r5 \n\t"
        "lsls r6, r6, #31 \n\t"
        "ldr r7, [r1, #24] \n\t"
        "lsrs r7, r7, #1 \n\t"
        "orrs r6, r7 \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r3, r5 \n\t"
        "str r2, [r0, #8] \n\t"
        /* column 3: p[j] + a[j] + ((a[j] << 31) | (a[j-1] >> 1)) */
        "ldr r2, [r1, #12] \n\t"
        "movs r4, #0 \n\t"
        "adds r2, r2, r3 \n\t"
        "adcs r4, r5 \n\t"
        "ldr r6, [r1, #32] \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r4, r5 \n\t"
        "lsls r6, r6, #31 \n\t"
        "ldr r7, [r1, #28] \n\t"
        "lsrs r7, r7, #1 \n\t"
        "orrs r6, r7 \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r4, r5 \n\t"
        "str r2, [r0, #12] \n\t"
        /* column 4: p[j] + a[j] + ((a[j] << 31) | (a[j-1] >> 1)) */
        "ldr r2, [r1, #16] \n\t"
        "movs r3, #0 \n\t"
        "adds r2, r2, r4 \n\t"
        "adcs r3, r5 \n\t"
        "ldr r6, [r1, #36] \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r3, r5 \n\t"
        "lsls r6, r6, #31 \n\t"
        "ldr r7, [r1, #32] \n\t"
        "lsrs r7, r7, #1 \n\t"
        "orrs r6, r7 \n\t"
        "adds r2, r2, r6 \n\t"
        "adcs r3, r5 \n\t"
        "str r2, [r0, #16] \n\t"
        "ldr r7, [r1, #36] \n\t"
        "lsrs r7, r7, #1 \n\t"
        "adds r3, r3, r7 \n\t"
        /* fold carry (c < 2^31 + 3): r += c * (2^31 + 1) */
        "lsrs r2, r3, #1 \n\t"
        "lsls r1, r3, #31 \n\t"
        "adds r1, r1, r3 \n\t"
        "adcs r2, r5 \n\t"
        "ldr r6, [r0, #0] \n\t"
        "adds r6, r6, r1 \n\t"
        "str r6, [r0, #0] \n\t"
        "ldr r6, [r0, #4] \n\t"
        "adcs r6, r2 \n\t"
        "str r6, [r0, #4] \n\t"
        "ldr r6, [r0, #8] \n\t"
        "adcs r6, r5 \n\t"
        "str r6, [r0, #8] \n\t"
        "ldr r6, [r0, #12] \n\t"
        "adcs r6, r5 \n\t"
        "str r6, [r0, #12] \n\t"
        "ldr r6, [r0, #16] \n\t"
        "adcs r6, r5 \n\t"
        "str r6, [r0, #16] \n\t"
        "movs r7, #0 \n\t"
        "adcs r7, r7 \n\t"
        "mov r8, r7 \n\t"
        /* fold s = c2 | 1 (subtract p, or add p if c2 == -1) */
        "movs r1, #1 \n\t"
        "orrs r1, r7 \n\t"
        "asrs r2, r1, #31 \n\t"
        "lsls r3, r1, #31 \n\t"
        "adds r3, r3, r1 \n\t"
        "ldr r4, [r0, #0] \n\t"
        "adds r4, r4, r3 \n\t"
        "str r4, [r0, #0] \n\t"
        "ldr r4, [r0, #4] \n\t"
        "adcs r4, r2 \n\t"
        "str r4, [r0, #4] \n\t"
        "ldr r4, [r0, #8] \n\t"
        "adcs r4, r2 \n\t"
        "str r4, [r0, #8] \n\t"
        "ldr r4, [r0, #12] \n\t"
        "adcs r4, r2 \n\t"
        "str r4, [r0, #12] \n\t"
        "ldr r4, [r0, #16] \n\t"
        "adcs r4, r2 \n\t"
        "str r4, [r0, #16] \n\t"
        "movs r4, #0 \n\t"
        "adcs r2, r4 \n\t"
        /* undo (add p) if c2 == 0 and the previous fold did not carry */
        "mov r1, r8 \n\t"
        "orrs r1, r2 \n\t"
        "rsbs r3, r1, #0 \n\t"
        "orrs r3, r1 \n\t"
        "asrs r3, r3, #31 \n\t"
        "mvns r3, r3 \n\t"
        "lsrs r1, r3, #1 \n\t"
        "ldr r2, [r0, #0] \n\t"
        "adds r2, r2, r1 \n\t"
        "str r2, [r0, #0] \n\t"
        "ldr r2, [r0, #4] \n\t"
        "adcs r2, r3 \n\t"
        "str r2, [r0, #4] \n\t"
        "ldr r2, [r0, #8] \n\t"
        "adcs r2, r3 \n\t"
        "str r2, [r0, #8] \n\t"
        "ldr r2, [r0, #12] \n\t"
        "adcs r2, r3 \n\t"
        "str r2, [r0, #12] \n\t"
        "ldr r2, [r0, #16] \n\t"
        "adcs r2, r3 \n\t"
        "str r2, [r0, #16] \n\t"
        RESUME_SYNTAX
        : "+r" (r0), "+r" (r1)
        :
        : "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "cc", "memory"
    );
}
#define asm_mmod_fast_secp160r1 1
#endif /* uECC_SUPPORTS_secp160r1 */

