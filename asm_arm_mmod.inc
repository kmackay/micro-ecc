/* Computes result = product % p (secp192r1), constant time.
   t + s1 + s2 + s3 (algorithm 5 and 6 from
   http://www.isys.uni-klu.ac.at/PDF/2001-0126-MT.pdf), then the carry is
   folded back using 2^192 = 2^64 + 1 (mod p). Folding c adds the two's
   complement words of c * (2^64 + 1): [c, s, c + s, s, s, s] (s = c >> 31). */
static void vli_mmod_fast_secp192r1(uint32_t *result, uint32_t *product) {
    register uint32_t *r0 __asm__("r0") = result;
    register uint32_t *r1 __asm__("r1") = product;
    __asm__ volatile (
        ".syntax unified \n\t"
        "ldm r1!, {r2-r7} \n\t"
        "ldm r1, {r8-r12, r14} \n\t"
        "mov r1, #0 \n\t"
        /* + s1 = (a0, a1, a2, a3, a4, a5) */
        "adds r2, r2, r8 \n\t"
        "adcs r3, r3, r9 \n\t"
        "adcs r4, r4, r10 \n\t"
        "adcs r5, r5, r11 \n\t"
        "adcs r6, r6, r12 \n\t"
        "adcs r7, r7, r14 \n\t"
        "adc r1, r1, #0 \n\t"
        /* + s2 = (0, 0, a0, a1, a2, a3) */
        "adds r4, r4, r8 \n\t"
        "adcs r5, r5, r9 \n\t"
        "adcs r6, r6, r10 \n\t"
        "adcs r7, r7, r11 \n\t"
        "adc r1, r1, #0 \n\t"
        /* + s3 = (a4, a5, a4, a5, 0, 0) */
        "adds r2, r2, r12 \n\t"
        "adcs r3, r3, r14 \n\t"
        "adcs r4, r4, r12 \n\t"
        "adcs r5, r5, r14 \n\t"
        "adcs r6, r6, #0 \n\t"
        "adcs r7, r7, #0 \n\t"
        "adc r1, r1, #0 \n\t"
        /* fold carry: r += c * (2^64 + 1) */
        "asr r8, r1, #31 \n\t"
        "add r9, r1, r8 \n\t"
        "adds r2, r2, r1 \n\t"
        "adcs r3, r3, r8 \n\t"
        "adcs r4, r4, r9 \n\t"
        "adcs r5, r5, r8 \n\t"
        "adcs r6, r6, r8 \n\t"
        "adcs r7, r7, r8 \n\t"
        "adc r1, r8, #0 \n\t"
        /* fold s = c2 | 1 (subtract p, or add p if c2 == -1) */
        "orr r10, r1, #1 \n\t"
        "asr r8, r10, #31 \n\t"
        "add r9, r10, r8 \n\t"
        "adds r2, r2, r10 \n\t"
        "adcs r3, r3, r8 \n\t"
        "adcs r4, r4, r9 \n\t"
        "adcs r5, r5, r8 \n\t"
        "adcs r6, r6, r8 \n\t"
        "adcs r7, r7, r8 \n\t"
        "adc r10, r8, #0 \n\t"
        /* undo (add p) if c2 == 0 and the previous fold did not carry */
        "orr r9, r1, r10 \n\t"
        "rsb r11, r9, #0 \n\t"
        "orr r9, r9, r11 \n\t"
        "mvn r1, r9, asr #31 \n\t"
        "asr r8, r1, #31 \n\t"
        "add r9, r1, r8 \n\t"
        "adds r2, r2, r1 \n\t"
        "adcs r3, r3, r8 \n\t"
        "adcs r4, r4, r9 \n\t"
        "adcs r5, r5, r8 \n\t"
        "adcs r6, r6, r8 \n\t"
        "adcs r7, r7, r8 \n\t"
        "adc r1, r8, #0 \n\t"
        "stm r0, {r2-r7} \n\t"
        RESUME_SYNTAX
        : "+r" (r0), "+r" (r1)
        :
        : "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "r14", "cc", "memory"
    );
