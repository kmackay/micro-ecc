        "adc r12, r12, #0 \n\t"
        "adds r10, r10, r2 \n\t"
        "adc r12, r12, #0 \n\t"
        "subs r10, r10, r4 \n\t"
        "sbc r12, r12, #0 \n\t"
        "subs r10, r10, r5 \n\t"
        "sbc r12, r12, #0 \n\t"
        "subs r10, r10, r6 \n\t"
        "sbc r12, r12, #0 \n\t"
        "subs r10, r10, r7 \n\t"
        "sbc r12, r12, #0 \n\t"
        "str r10, [r0, #28] \n\t"
        /* reload result words; fold carry: r += c * (2^224 - 2^192 - 2^96 + 1) */
        "ldm r0, {r2-r9} \n\t"
        "asr r1, r12, #31 \n\t"
        "rsb r10, r12, #0 \n\t"
        "asr r10, r10, #31 \n\t"
        "adds r2, r2, r12 \n\t"
        "adcs r3, r3, r1 \n\t"
        "adcs r4, r4, r1 \n\t"
        "sub r11, r1, r12 \n\t"
        "adcs r5, r5, r11 \n\t"
        "adcs r6, r6, r10 \n\t"
        "adcs r7, r7, r10 \n\t"
        "sub r11, r10, r12 \n\t"
        "adcs r8, r8, r11 \n\t"
        "add r11, r12, r10 \n\t"
        "adcs r9, r9, r11 \n\t"
        "adc r12, r1, #0 \n\t"
        /* fold s = c2 | 1 (subtract p, or add p if c2 == -1) */
        "orr r14, r12, #1 \n\t"
        "asr r1, r14, #31 \n\t"
        "rsb r10, r14, #0 \n\t"
        "asr r10, r10, #31 \n\t"
        "adds r2, r2, r14 \n\t"
        "adcs r3, r3, r1 \n\t"
        "adcs r4, r4, r1 \n\t"
        "sub r11, r1, r14 \n\t"
        "adcs r5, r5, r11 \n\t"
        "adcs r6, r6, r10 \n\t"
        "adcs r7, r7, r10 \n\t"
        "sub r11, r10, r14 \n\t"
        "adcs r8, r8, r11 \n\t"
        "add r11, r14, r10 \n\t"
        "adcs r9, r9, r11 \n\t"
        "adc r14, r1, #0 \n\t"
        /* undo (add p) if c2 == 0 and the previous fold did not carry */
        "orr r11, r12, r14 \n\t"
        "rsb r10, r11, #0 \n\t"
        "orr r11, r11, r10 \n\t"
        "mvn r12, r11, asr #31 \n\t"
        "and r11, r12, #1 \n\t"
        "adds r2, r2, r12 \n\t"
        "adcs r3, r3, r12 \n\t"
        "adcs r4, r4, r12 \n\t"
        "adcs r5, r5, #0 \n\t"
        "adcs r6, r6, #0 \n\t"
        "adcs r7, r7, #0 \n\t"
        "adcs r8, r8, r11 \n\t"
        "adc r9, r9, r12 \n\t"
        "stm r0, {r2-r9} \n\t"
        RESUME_SYNTAX
        : "+r" (r0), "+r" (r1)
        :
        : "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "r14", "cc", "memory"
    );
}
