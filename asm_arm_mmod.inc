/* Computes result = product % p (secp224r1), constant time.
   t + s1 + s2 - d1 - d2 (from http://www.nsa.gov/ia/_files/nist-routines.pdf)
   = t + B * (2^96 - 1) - 2^128 * (a4, a5, a6), where
   B = (a0, a1, a2, a3) + (a4, a5, a6, 0). The carry is folded back using
   2^224 = 2^96 - 1 (mod p): folding c adds the two's complement words of
   c * (2^96 - 1): [-c, m, m, c + m, s, s, s] (s = c >> 31, m = -c >> 31). */
static void vli_mmod_fast_secp224r1(uint32_t *result, uint32_t *product) {
    register uint32_t *r0 __asm__("r0") = result;
    register uint32_t *r1 __asm__("r1") = product;
    __asm__ volatile (
        ".syntax unified \n\t"
        "ldm r1!, {r2-r8} \n\t"
        "ldr r9, [r1, #16] \n\t"
        "ldr r10, [r1, #20] \n\t"
        "ldr r11, [r1, #24] \n\t"
        "mov r12, #0 \n\t"
        /* r -= 2^128 * (a4, a5, a6) */
        "subs r6, r6, r9 \n\t"
        "sbcs r7, r7, r10 \n\t"
        "sbcs r8, r8, r11 \n\t"
        "sbc r12, r12, #0 \n\t"
        /* B = (a0, a1, a2, a3) + (a4, a5, a6, 0) -> (r9, r10, r11, r14), carry -> r1 */
        "ldr r14, [r1, #0] \n\t"
        "adds r9, r9, r14 \n\t"
        "ldr r14, [r1, #4] \n\t"
        "adcs r10, r10, r14 \n\t"
        "ldr r14, [r1, #8] \n\t"
        "adcs r11, r11, r14 \n\t"
        "ldr r14, [r1, #12] \n\t"
        "mov r1, #0 \n\t"
        "adcs r14, r14, #0 \n\t"
        "adc r1, r1, #0 \n\t"
        /* r -= B */
        "subs r2, r2, r9 \n\t"
        "sbcs r3, r3, r10 \n\t"
        "sbcs r4, r4, r11 \n\t"
        "sbcs r5, r5, r14 \n\t"
        "sbcs r6, r6, r1 \n\t"
        "sbcs r7, r7, #0 \n\t"
        "sbcs r8, r8, #0 \n\t"
        "sbc r12, r12, #0 \n\t"
        /* r += 2^96 * B */
        "adds r5, r5, r9 \n\t"
        "adcs r6, r6, r10 \n\t"
        "adcs r7, r7, r11 \n\t"
        "adcs r8, r8, r14 \n\t"
        "adc r12, r12, r1 \n\t"
        /* fold carry: r += c * (2^96 - 1) */
        "asr r1, r12, #31 \n\t"
        "rsb r10, r12, #0 \n\t"
        "asr r9, r10, #31 \n\t"
        "adds r2, r2, r10 \n\t"
        "adcs r3, r3, r9 \n\t"
        "adcs r4, r4, r9 \n\t"
        "add r10, r12, r9 \n\t"
        "adcs r5, r5, r10 \n\t"
        "adcs r6, r6, r1 \n\t"
        "adcs r7, r7, r1 \n\t"
        "adcs r8, r8, r1 \n\t"
        "adc r12, r1, #0 \n\t"
        /* fold s = c2 | 1 (subtract p, or add p if c2 == -1) */
        "orr r11, r12, #1 \n\t"
        "asr r1, r11, #31 \n\t"
        "rsb r10, r11, #0 \n\t"
        "asr r9, r10, #31 \n\t"
        "adds r2, r2, r10 \n\t"
        "adcs r3, r3, r9 \n\t"
        "adcs r4, r4, r9 \n\t"
        "add r10, r11, r9 \n\t"
        "adcs r5, r5, r10 \n\t"
        "adcs r6, r6, r1 \n\t"
        "adcs r7, r7, r1 \n\t"
        "adcs r8, r8, r1 \n\t"
        "adc r11, r1, #0 \n\t"
        /* undo (add p) if c2 == 0 and the previous fold did not carry */
        "orr r10, r12, r11 \n\t"
        "rsb r14, r10, #0 \n\t"
        "orr r10, r10, r14 \n\t"
        "mvn r12, r10, asr #31 \n\t"
        "and r10, r12, #1 \n\t"
        "adds r2, r2, r10 \n\t"
        "adcs r3, r3, #0 \n\t"
        "adcs r4, r4, #0 \n\t"
        "adcs r5, r5, r12 \n\t"
        "adcs r6, r6, r12 \n\t"
        "adcs r7, r7, r12 \n\t"
        "adc r8, r8, r12 \n\t"
        "stm r0, {r2-r8} \n\t"
        RESUME_SYNTAX
        : "+r" (r0), "+r" (r1)
        :
        : "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "r14", "cc", "memory"
    );
