/* Computes result = product % p (secp256k1), constant time.
   lo + hi * 977 + hi * 2^32 using 2^256 = 2^32 + 977 (mod p); the top
   carry is folded back the same way, then p is subtracted once (and added
   back if that was not needed). */
static void vli_mmod_fast_secp256k1(uint32_t *result, uint32_t *product) {
    register uint32_t *r0 __asm__("r0") = result;
    register uint32_t *r1 __asm__("r1") = product;
    __asm__ volatile (
        ".syntax unified \n\t"
        "ldm r1!, {r2-r9} \n\t"
        "mov r10, #1024 \n\t"
        "sub r10, r10, #47 \n\t"
        /* r += hi * 977 (umaal chain, r11 = carry) and r += hi * 2^32 (flags) */
        "mov r11, #0 \n\t"
        "mov r14, #0 \n\t"
        "ldr r12, [r1, #0] \n\t"
        "umaal r2, r11, r12, r10 \n\t"
        "adds r3, r3, r12 \n\t"
        "ldr r12, [r1, #4] \n\t"
        "umaal r3, r11, r12, r10 \n\t"
        "adcs r4, r4, r12 \n\t"
        "ldr r12, [r1, #8] \n\t"
        "umaal r4, r11, r12, r10 \n\t"
        "adcs r5, r5, r12 \n\t"
        "ldr r12, [r1, #12] \n\t"
        "umaal r5, r11, r12, r10 \n\t"
        "adcs r6, r6, r12 \n\t"
        "ldr r12, [r1, #16] \n\t"
        "umaal r6, r11, r12, r10 \n\t"
        "adcs r7, r7, r12 \n\t"
        "ldr r12, [r1, #20] \n\t"
        "umaal r7, r11, r12, r10 \n\t"
        "adcs r8, r8, r12 \n\t"
        "ldr r12, [r1, #24] \n\t"
        "umaal r8, r11, r12, r10 \n\t"
        "adcs r9, r9, r12 \n\t"
        "ldr r12, [r1, #28] \n\t"
        "umaal r9, r11, r12, r10 \n\t"
        "adcs r12, r12, r11 \n\t"
        "adc r14, r14, #0 \n\t"
        /* fold T = r14:r12 (< 2^33): r += T * (2^32 + 977) */
        "mov r11, #0 \n\t"
        "umlal r2, r11, r12, r10 \n\t"
        "mul r1, r14, r10 \n\t"
        "add r11, r11, r1 \n\t"
        "adds r12, r12, r11 \n\t"
        "adc r14, r14, #0 \n\t"
        "mov r11, #0 \n\t"
        "adds r3, r3, r12 \n\t"
        "adcs r4, r4, r14 \n\t"
        "adcs r5, r5, #0 \n\t"
        "adcs r6, r6, #0 \n\t"
        "adcs r7, r7, #0 \n\t"
        "adcs r8, r8, #0 \n\t"
        "adcs r9, r9, #0 \n\t"
        "adc r11, r11, #0 \n\t"
        /* c2 = r11 in {0, 1}: fold +1 (subtract p) */
        "mov r12, #0 \n\t"
        "adds r2, r2, r10 \n\t"
        "adcs r3, r3, #1 \n\t"
        "adcs r4, r4, #0 \n\t"
        "adcs r5, r5, #0 \n\t"
        "adcs r6, r6, #0 \n\t"
        "adcs r7, r7, #0 \n\t"
        "adcs r8, r8, #0 \n\t"
        "adcs r9, r9, #0 \n\t"
        "adc r12, r12, #0 \n\t"
        /* undo (fold -1, i.e. add p) if c2 == 0 and the fold did not carry */
        "orr r11, r11, r12 \n\t"
        "sub r11, r11, #1 \n\t"
        "mul r12, r11, r10 \n\t"
        "add r14, r11, r11 \n\t"
        "adds r2, r2, r12 \n\t"
        "adcs r3, r3, r14 \n\t"
        "adcs r4, r4, r11 \n\t"
        "adcs r5, r5, r11 \n\t"
        "adcs r6, r6, r11 \n\t"
        "adcs r7, r7, r11 \n\t"
        "adcs r8, r8, r11 \n\t"
        "adcs r9, r9, r11 \n\t"
        "stm r0, {r2-r9} \n\t"
        RESUME_SYNTAX
        : "+r" (r0), "+r" (r1)
        :
        : "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "r14", "cc", "memory"
    );
}
